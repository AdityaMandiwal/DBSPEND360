# Development Environment Configuration
# DBSpend360 - Databricks Cost Analytics Dashboard

[cloud]
# Supported platforms: AWS, Azure, GCP
# This value drives, end-to-end:
#   1. Notebook selection in jobs/resource_templates/DBSPEND360.yaml
#      (resolves to ${cloud_provider}_cloud_cost_explorer_app).
#   2. Cluster-attributes column reads in
#      server/services/databricks_service.get_cluster_details
#      (aws_attributes / azure_attributes / gcp_attributes).
#   3. UI label rendering via /api/cloud-platform and
#      client/src/contexts/CloudPlatformContext.tsx.
#   4. LLM prompt wording in server/services/llm_service.py
#      (cluster availability label).
platform = Azure

[databricks]
# SQL Warehouse Configuration
# Azure workspace (adb-984752964297111.11.azuredatabricks.net) "Shared Endpoint"
warehouse_id = 148ccb90800933a1
# Data Source Configuration (Full qualified table name)
table_name = dbspend360.03apr.dbspend360_total_job_spends
# All-Purpose cluster rollup (Full qualified table name).
# Source for the All-Purpose Clusters tab; written by
# jobs/notebooks/all_purpose_spends_app.ipynb. Defaults in config_loader.py
# derive `<schema_name>.dbspend360_total_all_purpose_spends` when omitted;
# this line is for explicitness.
all_purpose_table_name = dbspend360.03apr.dbspend360_total_all_purpose_spends
# Instance Pool rollup (Full qualified table name).
# Source for the Instance Pools tab; written by
# jobs/notebooks/pool_spends_app.ipynb. Defaults in config_loader.py
# derive `<schema_name>.dbspend360_total_pool_spends` when omitted;
# this line is for explicitness.
pool_table_name = dbspend360.03apr.dbspend360_total_pool_spends
# Pipeline Compute rollup (Full qualified table name).
# Source for the Pipeline Compute tab; written by
# jobs/notebooks/pipeline_spends_app.ipynb. Defaults in config_loader.py
# derive `<schema_name>.dbspend360_total_pipeline_spends` when omitted;
# this line is for explicitness.
pipeline_table_name = dbspend360.03apr.dbspend360_total_pipeline_spends
# SQL Warehouse rollup (Full qualified table name).
# Source for the SQL Warehouses tab; written by
# jobs/notebooks/sql_warehouse_spends_app.ipynb. Defaults in config_loader.py
# derive `<schema_name>.dbspend360_total_sql_warehouse_spends` when omitted;
# this line is for explicitness.
sql_warehouse_table_name = dbspend360.03apr.dbspend360_total_sql_warehouse_spends
# Optional: Schema for organizing data (Full qualified schema name)
schema_name = dbspend360.03apr

[features]
# Feature flags for development
enable_cost_analysis = true
enable_cluster_analysis = true
enable_export = true
# Lazy read-time DBU product breakdown on the Job Clusters tab (system.billing.usage).
enable_job_dbu_breakdown = true
# AI cost analysis on the SQL Warehouses tab (/api/warehouses/{id}/analyze).
enable_warehouse_analysis = true

[performance]
# Performance tuning for development
query_timeout_seconds = 30
cache_ttl_minutes = 5
max_results_per_page = 100

[logging]
# Logging configuration
log_level = INFO
enable_debug_endpoints = true